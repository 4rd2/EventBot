# Copy this file to .env and fill in your values
# cp .env.example .env  (Mac/Linux)
# copy .env.example .env  (Windows)

# Discord webhook URL — create one in your server under:
# Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Supabase — events + phone subscribers backend (PLAN.md §4.2).
# Project Settings → API: URL + service_role key (NOT the anon key).
# Leave unset until the Supabase project exists — all Supabase steps skip cleanly.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key

# Twilio — SMS delivery for phone notifications.
# Console → Account Info: SID + auth token, plus your Twilio phone number.
# Leave unset until configured — the phone notifier skips cleanly.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15551234567
